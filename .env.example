# Dynamic Pricing Engine — environment template
# Copy to .env and fill in. Validated at boot by pricing/config.py (NFR-022).

# ---------------------------------------------------------------------------
# LLM Gateway (LiteLLM, OpenAI-compatible). Backend-only — the UI never sees
# these values (FR-072, NFR-011).
# ---------------------------------------------------------------------------
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_API_KEY=

# Role -> model alias mapping (D4, FR-004).
# NEVER hardcoded in source. Validated against the gateway's /model/info at
# boot; startup fails loudly listing the models actually available.
MODEL_ROUTER=gemini/gemini-2.5-flash
MODEL_NARRATOR=gemini/gemini-2.5-flash
MODEL_ANALYST=gemini/gemini-2.5-flash
MODEL_STRATEGIST=gemini/gemini-2.5-pro

# Sampling temperature for every chat call. Model families disagree about what
# they accept: the gpt-5 line rejects anything other than 1.0 outright with a
# 400, while others are happy at 0.2 and give steadier narration for it.
# 1.0 is the value that works everywhere, so it is the default.
#
# If a model refuses the value set here, the call is retried once with the
# parameter omitted rather than losing the narration - the warning names the
# model, so set this to whatever it accepts to avoid the wasted round trip.
#
# Lower is better where you want repeatable wording between runs. It does not
# affect any price: the numbers come from pricing/analytics and the model only
# explains them.
LLM_TEMPERATURE=1.0

# Embedding model for RAG (D5, FR-038). Resolved through the same gateway.
# When set, this is the preferred embedding path: it works in environments
# where the local MiniLM download is blocked by TLS interception (A-03).
# Leave blank to use local MiniLM, falling back to hashed n-grams.
#
# CHANGING THIS INVALIDATES EXISTING COLLECTIONS. A Chroma collection is fixed
# to the width of the first vectors written into it, and vectors from two
# different models are not comparable even at equal width. After changing it:
#   DELETE http://127.0.0.1:8000/api/rag/collections     (then re-upload)
# GET /api/rag/stats reports a mismatch until you do.
MODEL_EMBEDDING=
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# RAG chunking (FR-038)
#
# A chunk is the unit of retrieval AND the unit of citation. Too large and the
# model is handed three unrelated policies; too small and a rule is severed
# from the condition it applies under, so the retrieved fragment is true but
# useless. Tune per corpus.
#
#   recursive  priority-ordered separators - paragraph, line, sentence, word.
#              The sensible default; only cuts mid-word as a last resort.
#   character  a single separator. Predictable, blunt.
#   token      sized by model tokens rather than characters. Needs tiktoken,
#              which downloads its encoding on first use.
#   markdown   splits on heading structure, keeping a section with its heading.
CHUNK_STRATEGY=recursive
CHUNK_SIZE=900
CHUNK_OVERLAP=120
# Split points, highest priority first, pipe-delimited. \n is decoded. The
# trailing empty entry is the character-level split of last resort - removing
# it means an unbroken 5000-character line cannot be split at all.
CHUNK_SEPARATORS=\n\n|\n|. | |

# ---------------------------------------------------------------------------
# Competitor feed (FR-004, FR-005, D14)
#
# Persistent positioning per competitor: a multiplier on our reference price,
# so a discounter sits below us and a premium retailer above. The roster itself
# is configurable, not just the numbers - a different market has different
# rivals, which is the point of the pluggable feed interface.
COMPETITOR_BIAS={"MarketFresh": 1.04, "ValueMart": 0.93, "Prime Grocer": 1.00}
# Per-SKU idiosyncratic spread, centred on zero so the bias above stays the
# mean positioning rather than being shifted by the noise.
COMPETITOR_IDIOSYNCRATIC_PCT=14.0
# Slow day-over-day drift, so the continuous loop has genuine market movement
# to react to rather than a frozen snapshot.
COMPETITOR_DRIFT_PCT=3.5
# Share of SKU/competitor pairs out of stock. A price you cannot buy at exerts
# no competitive pressure, so these are excluded from the aggregates.
COMPETITOR_OUT_OF_STOCK_RATE=0.085

# ---------------------------------------------------------------------------
# Corporate TLS (NFR-016 .. NFR-020)
#
# PREFERRED: verify against the operating system certificate store, where a
# corporate intercepting proxy's root CA is already installed - it is how every
# browser on this machine reaches the same hosts without complaint. Python does
# not consult it by default; it ships `certifi`, a fixed bundle of public roots
# that cannot know about a private CA. Leaving this on fixes
# CERTIFICATE_VERIFY_FAILED for the gateway, embeddings, tiktoken and the
# MiniLM download, with verification fully ON and nothing to export by hand.
USE_OS_TRUST_STORE=true
#
# Alternative: point at an explicit CA bundle. Wins over the OS store.
# CA_BUNDLE_PATH=C:/path/to/corporate-root-ca.pem
CA_BUNDLE_PATH=
#
# LAST RESORT: disables MITM protection entirely. The client will accept ANY
# certificate, including a forged one. Only acceptable inside a corporate
# network already performing sanctioned interception. Never default it on;
# never use it for traffic crossing an untrusted network.
ALLOW_INSECURE_TLS=false

# ---------------------------------------------------------------------------
# Service ports — all unprivileged, >1024 (NFR-003)
# ---------------------------------------------------------------------------
COMMERCE_PORT=8001
PRICING_PORT=8000
UI_PORT=5173
COMMERCE_BASE_URL=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Local embedded storage (NFR-004, NFR-005, D9)
# ---------------------------------------------------------------------------
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Observability (D12, NFR-028). Local JSONL sink is always on regardless.
# Leave Langfuse keys blank if egress is blocked — the system degrades quietly.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Autonomy defaults (FR-100, FR-101). Supervised is the default posture.
# ---------------------------------------------------------------------------
OPERATING_MODE=supervised
BAND_MIN_CONFIDENCE=0.75
BAND_MAX_DELTA_PCT=10.0
BAND_MAX_VARIANCE=0.25
BAND_MARGIN_BUFFER_PCT=3.0

# ---------------------------------------------------------------------------
# Monte Carlo (FR-083, NFR-037). Seed fixed for reproducibility (FR-087).
# ---------------------------------------------------------------------------
MC_ITERATIONS=2000
MC_SEED=20260807

# ---------------------------------------------------------------------------
# Stability (FR-090, FR-091, FR-094)
# ---------------------------------------------------------------------------
OSCILLATION_WINDOW=4
OSCILLATION_MAX_REVERSALS=2
DAMPING_FACTOR=0.4
MIN_HOURS_BETWEEN_CHANGES=0

# ---------------------------------------------------------------------------
# Continuous loop (FR-121, FR-122). Never auto-starts.
# ---------------------------------------------------------------------------
LOOP_DEFAULT_INTERVAL_SECONDS=300
LOOP_MAX_ITERATIONS=100
